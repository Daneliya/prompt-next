{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "naive-ui": "^2.45.3",
    "pinyin-pro": "^3.29.5",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.2.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.12"
  }
}
